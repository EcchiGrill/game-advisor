generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  slug String @unique
  playtime Int
  rating Int 
  metacritic Int?
  coverUrl String
  genres String[]
  platforms String[]
  releasedAt DateTime
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
